# Адрес сайта RAFTING_CFO и API-ключ синхронизации мероприятий (семинаров)
# и судей. API-ключ должен СОВПАДАТЬ со значением API_KEY в .env самого
# сайта RAFTING_CFO (см. его .env.example, заголовок X-API-Key).
RAFTING_CFO_URL=http://127.0.0.1:5003
RAFTING_CFO_API_KEY=change-me-to-a-random-api-key

# Ключ для входящих запросов (routes/api.py) — общий на оба источника:
#  - RAFTING_CFO: приём и выдача заявок на семинар, POST/GET
#    /api/seminars/<id>/applications (значение должно СОВПАДАТЬ со
#    значением SPORTS_REFEREE_API_KEY в .env сайта RAFTING_CFO);
#  - COREZ: поиск судей при добавлении в судейскую коллегию соревнования,
#    GET /api/judges/search (значение должно СОВПАДАТЬ со значением
#    SPORTS_REFEREE_API_KEY в .env самого COREZ).
API_KEY=change-me-to-a-random-api-key

# Адрес системы COREZ (учёт соревнований по рафтингу) и API-ключ для
# добавления судей в судейские коллегии соревнований (кнопка на карточке
# судьи) — sync_corez_judges.py. Значение должно СОВПАДАТЬ со значением
# API_KEY в .env самого COREZ (см. его .env.example, заголовок X-API-Key).
COREZ_URL=http://127.0.0.1:5000
COREZ_API_KEY=change-me-to-a-random-api-key
