# Адрес сайта RAFTING_CFO и API-ключ синхронизации мероприятий (семинаров).
# API-ключ должен СОВПАДАТЬ со значением API_KEY в .env самого сайта
# RAFTING_CFO (см. его .env.example, заголовок X-API-Key).
RAFTING_CFO_URL=http://127.0.0.1:5003
RAFTING_CFO_API_KEY=change-me-to-a-random-api-key

# Ключ для входящих запросов от RAFTING_CFO (routes/api.py — приём и выдача
# заявок на семинар, POST/GET /api/seminars/<id>/applications).
# Должен СОВПАДАТЬ со значением SPORTS_REFEREE_API_KEY в .env сайта RAFTING_CFO.
API_KEY=change-me-to-a-random-api-key
